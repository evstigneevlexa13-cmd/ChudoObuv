<Window x:Class="ChudoObuv.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Состав заказа"
        Height="560"
        Width="900"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="OrderTitleTextBlock"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock x:Name="ClientTextBlock"
                       Margin="0,4,0,0"/>

            <StackPanel x:Name="DatePanel"
                        Orientation="Horizontal"
                        Margin="0,8">
                <TextBlock Text="Изменить дату заказа:"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="OrderDatePicker"
                            Width="150"
                            Margin="8,0"/>

                <Button Content="Сохранить дату"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveDateButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="TotalTextBlock"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,10"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="DeleteItemButton"
                        Content="Удалить позицию"
                        Click="DeleteItemButton_Click"/>

                <Button Content="Назад"
                        Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товарная позиция"
                                    Binding="{Binding ProductText}"
                                    Width="*"/>

                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeText}"
                                    Width="80"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Цена за единицу"
                                    Binding="{Binding UnitPriceText}"
                                    Width="150"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding LineTotalText}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>