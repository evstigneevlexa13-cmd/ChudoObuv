<Window x:Class="ChudoObuv.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Карточка товара"
        Height="720"
        Width="780"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ProductImage"
                   Width="240"
                   Height="240"
                   Stretch="Uniform"
                   VerticalAlignment="Top"/>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0">
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="CategoryTextBlock"
                           Margin="0,6,0,0"/>

                <TextBlock x:Name="PriceTextBlock"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="Состав:"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="CompositionTextBlock"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Описание:"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="DescriptionTextBlock"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="SizeRangeTextBlock"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="AvailableSizesTextBlock"
                           TextWrapping="Wrap"/>

                <Border Background="{StaticResource SecondaryBackgroundBrush}"
                        Padding="10"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Размер:"/>

                        <ComboBox x:Name="SizeComboBox"
                                  DisplayMemberPath="DisplayText"
                                  Margin="0,4,0,8"/>

                        <TextBlock Text="Количество пар:"/>

                        <TextBox x:Name="QuantityTextBox"
                                 Text="1"
                                 MaxLength="3"
                                 Width="80"
                                 HorizontalAlignment="Left"
                                 Margin="0,4,0,0"
                                 PreviewTextInput="QuantityTextBox_PreviewTextInput"/>

                        <TextBlock x:Name="QuantityHintTextBlock"
                                   Foreground="Firebrick"
                                   FontSize="12"
                                   Height="34"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddButton"
                                    Content="Добавить в заказ"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="AddButton_Click"/>

                            <Button Content="Назад"
                                    Click="BackButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>