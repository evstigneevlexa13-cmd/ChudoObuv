<Window x:Class="ChudoObuv.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Заказы"
        Height="560"
        Width="860"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="Список заказов"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Добавить заказ"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AddOrderButton_Click"/>

            <Button Content="Состав заказа"
                    Click="DetailsButton_Click"/>

            <Button Content="Удалить заказ"
                    Click="DeleteButton_Click"/>

            <Button Content="Назад"
                    Click="BackButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="OrdersGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding OrderId}"
                                    Width="60"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding DateText}"
                                    Width="130"/>

                <DataGridTextColumn Header="ФИО клиента"
                                    Binding="{Binding ClientName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalText}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>