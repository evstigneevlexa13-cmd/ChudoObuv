<Window x:Class="ChudoObuv.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Мой заказ"
        Height="520"
        Width="920"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="Состав заказа"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="TotalTextBlock"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,10"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton"
                        Content="Подтвердить заказ"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ConfirmButton_Click"/>

                <Button Content="Отказаться от заказа"
                        Click="CancelOrderButton_Click"/>

                <Button Content="Назад"
                        Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="CartListBox"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding TitleText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SizeText}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <Button Content="−"
                                    Width="32"
                                    Click="MinusButton_Click"/>

                            <TextBlock Text="{Binding Quantity}"
                                       Width="32"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button Content="+"
                                    Width="32"
                                    Click="PlusButton_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding UnitPriceText}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding LineTotalText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="5"
                                Content="Удалить"
                                Click="RemoveButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>