<Application x:Class="ChudoObuv.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MainBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="SecondaryBackgroundBrush"
                         Color="#D2F6E7"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#70B2AF"/>

        <Style x:Key="WindowStyle"
               TargetType="Window">
            <Setter Property="FontFamily"
                    Value="Calibri"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Background"
                    Value="{StaticResource MainBackgroundBrush}"/>

            <Setter Property="Icon"
                    Value="/Чудо Обувь.ico"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding"
                    Value="14,6"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Background"
                    Value="{StaticResource SecondaryBackgroundBrush}"/>
        </Style>

        <Style x:Key="AccentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>