<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Каталог товаров"
        Height="720"
        Width="1050"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="LogoImage"
                       Height="70"
                       Stretch="Uniform"/>

                <TextBlock Grid.Column="1"
                           Text="Каталог обуви"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="15,0"/>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="OrdersButton"
        Content="Заказы"
        Click="OrdersButton_Click"/>
                        <Button x:Name="CartButton"
                                Content="Мой заказ"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CartButton_Click"/>

                        <Button x:Name="BackButton"
                                Content="Выйти"
                                Click="BackButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="FilterPanel"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="10">
            <TextBlock Text="Поиск:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="SearchTextBox"
                     Width="250"
                     Margin="6,0,20,0"
                     TextChanged="SearchTextBox_TextChanged"/>

            <TextBlock Text="Цена:"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="SortComboBox"
                      Width="170"
                      Margin="6,0,20,0"
                      SelectedIndex="0"
                      SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <TextBlock Text="Категория:"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="CategoryComboBox"
                      Width="170"
                      Margin="6,0,0,0"
                      DisplayMemberPath="CategoryName"
                      SelectionChanged="FilterChanged"/>
        </StackPanel>

        <ListBox x:Name="ProductsListBox"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ProductsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="4"
                            Padding="8"
                            Background="{Binding RowBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Image}"
                                   Width="120"
                                   Height="120"
                                   Stretch="Uniform"/>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0">
                                <TextBlock Text="{Binding TitleText}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding CategoryName}"/>
                                <TextBlock Text="{Binding QuantityText}"/>

                                <TextBlock Text="{Binding Composition}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding PriceText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>