<Window x:Class="ChudoObuv.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Вход"
        Height="440"
        Width="420"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="30"
                VerticalAlignment="Center">
        <Image x:Name="LogoImage"
               Height="110"
               Stretch="Uniform"/>

        <TextBlock Text="Вход в систему"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <TextBlock Text="Логин:"/>

        <TextBox x:Name="LoginTextBox"
                 MaxLength="30"
                 FontSize="16"
                 Margin="0,4"
                 ToolTip="Только латинские буквы и цифры"
                 PreviewTextInput="LoginTextBox_PreviewTextInput"/>

        <TextBlock x:Name="LoginHintTextBlock"
                   Foreground="Firebrick"
                   FontSize="12"
                   Height="34"
                   TextWrapping="Wrap"/>

        <Button Content="Войти"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}"
                Click="LoginButton_Click"/>

        <Button Content="Войти как гость"
                Click="GuestButton_Click"/>
    </StackPanel>
</Window>